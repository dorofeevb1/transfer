# Upstream для проксирования запросов к Django Gunicorn
upstream django_server {
    # 'web' - это имя сервиса Django в docker-compose.yml
    server web:8000;
}

# Сервер для HTTP, который делает редирект на HTTPS
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    # Для Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Основной сервер для HTTPS
server {
    listen 443 ssl http2;
    server_name ${DOMAIN_NAME};
    charset utf-8;

    # Пути к SSL сертификатам внутри контейнера
    ssl_certificate /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/privkey.pem;
    # (Глобальные SSL-настройки, такие как протоколы и шифры, уже в nginx.conf)

    # Обслуживание медиафайлов Django (загруженных пользователями)
    location /media/ {
        alias /app/mediafiles/;
    }

    # Обслуживание статических файлов Django (админка и т.д.)
    location /static/ {
        alias /app/staticfiles/;
    }

    # Проксирование API и админки Django
    location ~ ^/(api|admin)/ {
        proxy_pass http://django_server;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_redirect off;
    }
    
    # Обслуживание статических файлов frontend (Angular SPA)
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
