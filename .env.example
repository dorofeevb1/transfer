# Django Settings for Development/Production
# Установите USE_SSL=true и настройте пути к сертификатам для продакшена.
# Установите USE_SSL=false для локальной разработки без SSL.
USE_SSL=false
# Установите DEBUG=False для продакшена.
DEBUG=True

# ВАЖНО: Укажите ваш домен для продакшена (например, yourdomain.com) или localhost для разработки.
DOMAIN_NAME=localhost
# Для продакшена добавьте ваш домен в ALLOWED_HOSTS.
ALLOWED_HOSTS=localhost,127.0.0.1,${DOMAIN_NAME}

# WARNING: Сгенерируйте новый ключ для продакшена! Можно использовать:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY='django-insecure-prod-placeholder-change-this-!@#$%^&*()'

# CORS/CSRF settings
# Для продакшена установите CORS_ALLOW_ALL_ORIGINS=False и укажите домен фронтенда.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://${DOMAIN_NAME}
CSRF_TRUSTED_ORIGINS=https://${DOMAIN_NAME}

# Database Settings
POSTGRES_DB=brio_db
POSTGRES_USER=brio_user
POSTGRES_PASSWORD=brio_password
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# SSL Certificate Paths on the HOST machine (ТОЛЬКО ДЛЯ USE_SSL=true)
# Укажите абсолютные или относительные пути к вашим SSL сертификатам на хост-машине.
# Пример для Let's Encrypt: /etc/letsencrypt/live/yourdomain.com/fullchain.pem
# Если USE_SSL=false, эти переменные не используются.
SSL_CERTIFICATE_PATH=./nginx/certs/fullchain.pem.example
SSL_CERTIFICATE_KEY_PATH=./nginx/certs/privkey.pem.example
