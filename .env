# Django Settings for Development/Production
# Установите USE_SSL=true для продакшена
USE_SSL=false
DEBUG=False

# ВАЖНО: Укажите ваш домен для продакшена или localhost для разработки.
DOMAIN_NAME=localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# WARNING: Сгенерируйте и замените этот ключ в реальном продакшене!
SECRET_KEY='django-insecure-dev-placeholder-!@#$%^&*()'

# CORS/CSRF settings
# Для разработки можно разрешить все источники или указать конкретные
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database Settings
POSTGRES_DB=brio_db
POSTGRES_USER=brio_user
POSTGRES_PASSWORD=brio_password
DATABASE_URL=postgres://brio_user:brio_password@db:5432/brio_db

# SSL Certificate Paths on the HOST machine (ТОЛЬКО ДЛЯ USE_SSL=true)
# Укажите абсолютные или относительные пути к вашим SSL сертификатам на хост-машине.
# Если USE_SSL=false, эти переменные не используются.
SSL_CERTIFICATE_PATH=./nginx/certs/fullchain.pem.example
SSL_CERTIFICATE_KEY_PATH=./nginx/certs/privkey.pem.example
